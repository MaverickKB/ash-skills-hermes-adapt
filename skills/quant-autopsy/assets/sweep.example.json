{
  "baseline": "bf16",
  "port": 8080,
  "health_url": "http://127.0.0.1:{port}/v1/models",
  "startup_timeout_s": 180,
  "server_cmd": [
    "tensorfold",
    "serve",
    "{model_path}",
    "--context",
    "32768",
    "--max-inflight",
    "1",
    "--no-drafts",
    "--host",
    "127.0.0.1",
    "--port",
    "{port}"
  ],
  "quants": [
    {
      "quant": "bf16",
      "quant_family": "bf16",
      "model_path": "checkpoints/model-bf16",
      "bpw": 16.0,
      "size_gib": 60.0,
      "vram_gib": 64.5,
      "kv_quant": "bf16",
      "engine": "tensorfold",
      "extra_args": ["--kv-cache", "bf16"]
    },
    {
