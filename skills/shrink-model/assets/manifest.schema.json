{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Inheritance manifest",
  "description": "Maps every tensor in the child checkpoint to its source in the parent. scripts/check_manifest.py checks a manifest against both checkpoints. A pass shows that the child matches this manifest. It does not show that the manifest is consistent across tensors.",
  "type": "object",
  "required": ["tensors"],
  "properties": {
    "parent": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "description": "Path or repository id"},
        "revision": {"type": "string"},
        "license": {"type": "string"}
      }
    },
    "child": {
      "type": "object",
      "properties": {
        "name": {"type": "string"},
        "total_params": {"type": "integer"},
        "active_params": {"type": "integer"}
      }
    },
    "counting_convention": {"type": "string"},
    "layer_map": {
      "description": "For each child layer in order, the parent layer index it came from.",
      "type": "array",
      "items": {"type": "integer", "minimum": 0}
    },
    "expert_id_map": {
      "description": "Keyed by child layer index. For each new expert id in order, the old expert id in the parent layer. Recovery uses this to align teacher and child routing.",
      "type": "object",
      "additionalProperties": {"type": "array", "items": {"type": "integer", "minimum": 0}}
    },
    "tensors": {
      "type": "array",
      "items": {"$ref": "#/$defs/entry"}
    }
  },
  "$defs": {
    "shape": {"type": "array", "items": {"type": "integer", "minimum": 0}},
    "selection": {
      "type": "object",
      "required": ["dim"],
      "properties": {
        "dim": {"type": "integer", "minimum": 0},
        "indices": {"type": "array", "items": {"type": "integer", "minimum": 0}},
        "range": {
          "description": "Half-open [start, stop] along the dim.",
          "type": "array",
          "items": {"type": "integer", "minimum": 0},
          "minItems": 2,
          "maxItems": 2
        }
      },
      "oneOf": [{"required": ["indices"]}, {"required": ["range"]}],
      "additionalProperties": false
    },
    "entry": {
      "type": "object",
      "required": ["child", "op"],
      "properties": {
        "child": {"type": "string", "description": "Tensor name in the child checkpoint"},
        "op": {"enum": ["copy", "index_select", "transform", "new_init"]},
        "parent": {
          "description": "Source tensor name. A transform may list several.",
          "oneOf": [{"type": "string"}, {"type": "array", "items": {"type": "string"}, "minItems": 1}]
        },
        "select": {"type": "array", "items": {"$ref": "#/$defs/selection"}, "minItems": 1},
        "transform": {"type": "string", "description": "What was done, precisely enough to reproduce"},
        "init": {"type": "string", "description": "How a new tensor was initialized"},
        "parent_shape": {"$ref": "#/$defs/shape"},
        "child_shape": {"$ref": "#/$defs/shape"},
        "note": {"type": "string"}
      },
      "allOf": [
        {
          "if": {"properties": {"op": {"const": "copy"}}},
          "then": {"required": ["parent"], "properties": {"parent": {"type": "string"}}}
        },
        {
          "if": {"properties": {"op": {"const": "index_select"}}},
          "then": {"required": ["parent", "select"], "properties": {"parent": {"type": "string"}}}
        },
        {
          "if": {"properties": {"op": {"const": "transform"}}},
          "then": {"required": ["parent", "transform"]}
        },
        {
          "if": {"properties": {"op": {"const": "new_init"}}},
          "then": {"required": ["init"]}
        }
      ]
    }
  }
}
